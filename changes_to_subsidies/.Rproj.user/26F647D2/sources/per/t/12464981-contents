#'

decile_sum <- function(current_data, suffix, weight_var, rank) {
  dif1 <- paste0("ditx_itb", suffix, "_pc")
  dif2 <- paste0("dsub_ele", suffix, "_pc")
  dif3 <- paste0("dcomp", suffix, "_pc")
  neto <- paste0("nitx", suffix, "_pc")
  
  
  variables_to_sum <- c(
    "itx_itb0_pc", "sub_ele0_pc",
    paste0("itx_itb", suffix, "_pc"),
    paste0("sub_ele", suffix, "_pc"),
    paste0("comp", suffix, "_pc"),
    paste0("ditx_itb", suffix, "_pc"),
    paste0("dsub_ele", suffix, "_pc"),
    paste0("dcomp", suffix, "_pc"), paste0("nitx", suffix, "_pc")
  )
  
  
  current_data <- current_data %>%
    mutate(
      !!sym(dif1) := !!sym(paste0("itx_itb", 0, "_pc")) -
        !!sym(paste0("itx_itb", suffix, "_pc")),
      !!sym(dif2) := !!sym(paste0("sub_ele", 0, "_pc")) -
        !!sym(paste0("sub_ele", suffix, "_pc")),
      !!sym(dif3) := !!sym(paste0("comp", 0, "_pc")) -
        !!sym(paste0("comp", suffix, "_pc")),
      !!sym(neto) := !!sym(dif1) + !!sym(dif2) - !!sym(dif3)
    ) %>%
    group_by({{ rank }}) %>%
    summarise(across(all_of(variables_to_sum), ~
                       sum(. * !!sym(weight_var) / 1000000, na.rm = TRUE))) %>%
    arrange({{ rank }}) %>%
    as_tibble() %>%
    adorn_totals("row") %>%
    mutate(across(where(is.numeric), ~ round(., digits = 1)))
  
  current_data
}

#' Estimar totales según grupo especificado (en porcentaje del PIB)
#' @param current_data data frame con los datos de ingresos
#' @param suffix es un valor numérico correspondiente al escenario
#' @param weight_var es el factor de expansión
#' @param rank es la variable de agrupación (deciles, por ejemplo)
#'
#' @export
#'

decile_pib <- function(current_data, suffix, weight_var, rank) {
  variables_to_sum <- c("itx_itb0_pc", "sub_ele0_pc",
    paste0("itx_itb", suffix, "_pc"),  paste0("sub_ele", suffix, "_pc"),
    paste0("comp", suffix, "_pc")
  )
  
  itb_n <- paste0("itx_itb", suffix, "_pc")
  sub_n <- paste0("sub_ele", suffix, "_pc")
  com_n <- paste0("comp", suffix, "_pc")
  
  dif1 <- paste0("ditx_itb", suffix, "_pc")
  dif2 <- paste0("dsub_ele", suffix, "_pc")
  dif3 <- paste0("dcomp",    suffix, "_pc")
  neto <- paste0("nitx",    suffix, "_pc")
  
  f_itb <- vs_itb / (v_itb / v_pib)
  f_sub <- vs_sub / (v_sub / v_pib)
  
  current_data <- current_data %>%
    group_by({{ rank }}) %>%
    summarise(across(all_of(variables_to_sum), ~
                       sum(. * !!sym(weight_var) / 1000000, na.rm = TRUE))) %>%
    arrange({{ rank }}) %>%
    as_tibble() %>%
    adorn_totals("row") %>%
    mutate(across(where(is.numeric), ~ round(., digits = 1))) %>%
    mutate(
      itx_itb0_pc  =  itx_itb0_pc / f_itb * 100,
      sub_ele0_pc  =  sub_ele0_pc / f_sub * 100,
      !!sym(itb_n) := !!sym(paste0("itx_itb", suffix, "_pc")) / f_itb * 100,
      !!sym(sub_n) := !!sym(paste0("sub_ele", suffix, "_pc")) / f_sub * 100,
      !!sym(com_n) := !!sym(paste0("comp", suffix, "_pc")) / v_pib * 100
    ) %>%
    mutate(
      !!sym(dif1) := !!sym(paste0("itx_itb", suffix, "_pc")) - itx_itb0_pc,
      !!sym(dif2) := !!sym(paste0("sub_ele", suffix, "_pc")) - sub_ele0_pc,
      !!sym(dif3) := !!sym(paste0("comp", suffix, "_pc")),
      !!sym(neto) := !!sym(dif1) + !!sym(dif2) - !!sym(dif3)
    )
  
  current_data
}



#' Estimar concentración/incidencia según grupo especificado (% del total que va al grupo)
#' @param current_data data frame con los datos de ingresos
#' @param suffix es un valor numérico correspondiente al escenario
#' @param weight_var es el factor de expansión
#' @param rank es la variable de agrupación (deciles, por ejemplo)
#' @param opt es la opción de cálculo (1, 2 o 3)
#'
#' @export
#'
suma_esp <- function(current_data, suffix, weight_var, rank, opt) {
  # Manejo de errores inicial
  if (!suffix %in% seq_along(escenarios$sim_esp)) {
    stop("suffix no es un índice válido para escenarios$sim_esp.")
  }
  if (!weight_var %in% names(current_data)) {
    stop("weight_var no se encuentra en current_data.")
  }
  if (!as.character(rlang::enexpr(rank)) %in% names(current_data)) {
    stop("rank no se encuentra en current_data.")
  }
  if (!opt %in% c(1, 2, 3)) {
    stop("opt debe ser 1, 2 o 3.")
  }
  
  # Obtener el escenario correspondiente al sufijo
  
  
  # Construir los nombres de las variables a sumar
  base_vars <- c("itx_cmnt", "itx_tabc", "itx_bnas", "itx_balc", "itx_comb", "itx_comi")
  
  # # Generar los nombres de las nuevas variables
  new_vars <- paste0(base_vars, suffix, "_pc")
  
  
  variables_to_sum <- c(
    paste0(base_vars, "0_pc"),
    paste0(base_vars, suffix, "_pc"),
    # paste0("d", base_vars, sim_esc, "_pc")
    paste0("d", base_vars, suffix, "_pc")
  )
  
  # Construir los nombres de las diferencias para las mutaciones
  dif_vars <- paste0("d", base_vars, suffix, "_pc")
  
  for (i in seq_along(base_vars)) {
    col_name <- dif_vars[i]
    col_0 <- paste0(base_vars[i], "0_pc")
    col_suffix <- paste0(base_vars[i], suffix, "_pc")
    # current_data[[col_name]] <- current_data[[col_suffix]] - current_data[[col_0]]
    current_data <- current_data %>%
      mutate(!!sym(col_name) := !!sym(paste0(col_suffix)) - !!sym(paste0(col_0)))
  }
  
  
  # result <- current_data %>%
  #     select(all_of(variables_to_sum))
  
  if (opt == 1) {
    # Opción 1: Suma ponderada y porcentaje del total
    result <- current_data %>%
      group_by({{ rank }}) %>%
      summarise(across(
        all_of(variables_to_sum),
        ~ sum(. * .data[[weight_var]], na.rm = TRUE)
      )) %>%
      arrange({{ rank }}) %>%
      filter(!is.na({{ rank }})) %>%
      as_tibble() %>%
      adorn_totals("row")
    
    totales <- result %>%
      filter({{ rank }} != "Total") %>%
      summarise(across(where(is.numeric), sum))
    
    result <- result %>%
      mutate(across(where(is.numeric), ~ . * 100 / totales[[cur_column()]])) %>%
      mutate(across(
        where(is.numeric),
        ~ ifelse(is.na(.), 0, round(., digits = 1))
      ))
  } else if (opt == 2) {
    # Opción 2: Incidencia relativa a yd_pc
    incval <- current_data %>%
      group_by({{ rank }}) %>%
      summarise(incpc = sum(yd_pc * !!sym(weight_var), na.rm = TRUE)) %>%
      arrange({{ rank }}) %>%
      filter(!is.na({{ rank }})) %>%
      adorn_totals("row")
    
    result <- current_data %>%
      group_by({{ rank }}) %>%
      summarise(across(all_of(variables_to_sum), ~
                         sum(. * .data[[weight_var]], na.rm = TRUE))) %>%
      arrange({{ rank }}) %>%
      filter(!is.na({{ rank }})) %>%
      adorn_totals("row") %>%
      left_join(incval, by = as_label(enquo(rank))) %>%
      mutate(across(all_of(variables_to_sum), ~ (. * 100) / incpc)) %>%
      select(-incpc) %>%
      mutate(across(where(is.numeric), ~ round(., digits = 3)))
  } else if (opt == 3) {
    # Opción 3: Suma ponderada dividida por 1,000,000
    f_esp <- vs_esp / (v_esp / v_pib)
    result <- current_data %>%
      group_by({{ rank }}) %>%
      summarise(across(all_of(variables_to_sum), ~
                         sum(. * !!sym(weight_var) / 1000000, na.rm = TRUE))) %>%
      arrange({{ rank }}) %>%
      as_tibble() %>%
      adorn_totals("row") %>%
      mutate(across(where(is.numeric), ~ round((. / f_esp) * 100, digits = 3)))
  }
  
  return(result)
}

