#' Brecha de la pobreza por hogar en quetzales al mes para cada escenario
#'
#' @param x base, data frame
#' @param w, h, r vectores [factor de expansión, tamaño del hogar,
#' @param ... parentesco - para incluir solo el jefe del hogar-]
#' @param pl poverty line
#'
#' @export

calc_br <-
  function(x,
           pl,
           w = rep(1, length(x)),
           h = rep(1, length(h)),
           r = rep(1, length(r)),
           na.rm = TRUE,
           ...) {
    if (is.null(w)) {
      w <- rep(1, length(x))
    }
    
    if (na.rm) {
      drop1 <- is.na(x)
      drop2 <- is.na(w)
      drop3 <- is.na(pl)
      drop4 <- is.na(h)
      x <- x[!(drop1 | drop2 | drop3 | drop4)]
      w <- w[!(drop1 | drop2 | drop3 | drop4)]
      pl <- pl[!(drop1 | drop2 | drop3 | drop4)]
      h <- h[!(drop1 | drop2 | drop3 | drop4)]
      r <- r[!(drop1 | drop2 | drop3 | drop4)]
    }
    br <- if_else(pl > x, (pl - x) * h / 12, 0)
    weighted.mean((ifelse(r == 1, br, NA)), na.rm = TRUE, w)
  }

#' Estima datos de pobreza
#' @param x,w, pline, r, h, y0
#' @param vectores numéricos con datos de base de ingresos (x), linea de pobreza
#' @param (pl), r, h, y0
estima_pov <- function(x, pline, r, h, y0) {
  # Calcular valores iniciales
  pline12 <- weighted.mean(DOM_results[[pline]], DOM_results$factor) / 12
  pline12h <- weighted.mean(
    DOM_results[[pline]] * DOM_results$hsize,
    DOM_results$factor
  ) / 12
  
  # Asegurarnos de que tenemos todas las variables necesarias antes del pivot
  x <- x %>%
    ungroup() %>%
    select(
      yd0_pc, # Agregamos explícitamente yd0_pc
      any_of(matches("y[d|c|z|i|e][0-9]_pc")),
      !!sym(pline),
      !!sym(r),
      !!sym(h),
      !!sym(y0),
      factor
    )
  
  # Guardar yd0_pc antes del pivot
  yd0_pc_values <- x$yd0_pc
  
  x <- x %>%
    pivot_longer(
      names_to = "var",
      cols = starts_with("y")
    ) %>%
    group_by(var) %>%
    mutate(yd0_pc = yd0_pc_values) %>% # Reintroducir yd0_pc después del pivot
    summarise(
      rate = calc_pov_fgt(
        x = value,
        pl = !!sym(pline),
        alpha = 0,
        w = factor,
        na.rm = TRUE
      ) * 100,
      headcount = round(
        calc_pov_fgt(
          x = value,
          pl = !!sym(pline),
          alpha = 0,
          w = factor,
          na.rm = TRUE
        ) * sum(factor, na.rm = TRUE)
      ),
      gap = calc_pov_fgt(
        x = value,
        pl = !!sym(pline),
        alpha = 1,
        w = factor,
        na.rm = TRUE
      ) * 100,
      gap_lcuhh = calc_br(
        x = value,
        pl = !!sym(pline),
        h = !!sym(h),
        r = !!sym(r),
        w = factor,
        na.rm = TRUE
      ),
      gap_lcupo = calc_br0(
        x = value,
        pl = !!sym(pline),
        h = !!sym(h),
        r = !!sym(r),
        y0 = yd0_pc, # Usamos yd0_pc que mantuvimos
        w = factor,
        na.rm = TRUE
      ),
      gap_lcupon = calc_br1(
        x = value,
        pl = !!sym(pline),
        h = !!sym(h),
        r = !!sym(r),
        y0 = yd0_pc, # Usamos yd0_pc que mantuvimos
        w = factor,
        na.rm = TRUE
      ),
      gap_lcupopib = calc_br2(
        x = value,
        pl = !!sym(pline),
        h = !!sym(h),
        r = !!sym(r),
        y0 = yd0_pc, # Usamos yd0_pc que mantuvimos
        w = factor,
        na.rm = TRUE
      ),
      severity = calc_pov_fgt(
        x = value,
        pl = !!sym(pline),
        alpha = 2,
        w = factor,
        na.rm = TRUE
      ) * 100
    ) %>%
    ungroup() %>%
    pivot_longer(
      names_to = "parameter",
      cols = c(
        "rate", "headcount", "gap", "gap_lcuhh", "gap_lcupo", "gap_lcupon",
        "gap_lcupopib", "severity"
      ),
      values_to = "Value"
    ) %>%
    filter(var != "yd_hh") %>%
    separate(var, into = c("var", "escenario"), sep = "_") %>%
    mutate(
      escenario = as.numeric(if_else(str_sub(var, 3, 3) == "", "0",
                                     str_sub(var, 3, 3)
      )),
      var = str_sub(var, 1, 2)
    )
  
  # Convertir la columna en un factor con el orden deseado
  custom_order <- c("yd", "yc", "yz", "yi", "ys")
  x$var <- factor(x$var, levels = custom_order)
  
  # Ordenar basado en el orden personalizado
  x <- x %>% arrange(var)
  
  return(x)
}

pov_matriz <- function(data, suffix) {
  # Validar que el sufijo comience con "_"
  if (!grepl("^_", suffix)) {
    stop("El sufijo debe comenzar con '_'.")
  }
  
  # Filtrar y transformar los datos
  p1 <- data %>%
    filter(parameter != "severity") %>%
    pivot_wider(
      names_from = c("var", "escenario"), names_sep = "_",
      values_from = Value
    ) %>%
    mutate(
      # Crear dinámicamente las diferencias para múltiples variables
      across(matches(paste0("^(yd|yc|yz|yi|ys)", suffix, "$")),
             ~ . - get(sub(suffix, "_0", cur_column())),
             .names = "d{.col}"
      )
    )
  
  # Crear una matriz con los resultados de las selecciones específicas
  result <- rbind(
    p1 %>%
      filter(parameter == "rate") %>%
      select(any_of(c(
        paste0("yd_0"), paste0("yc", suffix),
        paste0("yz", suffix), paste0("yi", suffix), paste0("ys", suffix)
      ))) %>%
      as.numeric(),
    p1 %>%
      filter(parameter == "rate") %>%
      select(matches(paste0("^d(yd|yc|yz|yi|ys)", suffix, "$"))) %>%
      as.numeric(),
    p1 %>%
      filter(parameter == "headcount") %>%
      select(matches(paste0("^d(yd|yc|yz|yi|ys)", suffix, "$"))) %>%
      as.numeric(),
    p1 %>%
      filter(parameter == "gap") %>%
      select(any_of(c(
        paste0("yd_0"), paste0("yc", suffix),
        paste0("yz", suffix), paste0("yi", suffix), paste0("ys", suffix)
      ))) %>%
      as.numeric(),
    p1 %>%
      filter(parameter == "gap_lcuhh") %>%
      select(any_of(c(
        paste0("yd_0"), paste0("yc", suffix),
        paste0("yz", suffix), paste0("yi", suffix), paste0("ys", suffix)
      ))) %>%
      as.numeric(),
    p1 %>%
      filter(parameter == "gap_lcupo") %>%
      select(any_of(c(
        paste0("yd_0"), paste0("yc", suffix),
        paste0("yz", suffix), paste0("yi", suffix), paste0("ys", suffix)
      ))) %>%
      as.numeric(),
    p1 %>%
      filter(parameter == "gap_lcupon") %>%
      select(any_of(c(
        paste0("yd_0"), paste0("yc", suffix),
        paste0("yz", suffix), paste0("yi", suffix), paste0("ys", suffix)
      ))) %>%
      as.numeric() %>%
      replace_na(0),
    p1 %>%
      filter(parameter == "gap_lcupopib") %>%
      select(any_of(c(
        paste0("yd_0"), paste0("yc", suffix),
        paste0("yz", suffix), paste0("yi", suffix), paste0("ys", suffix)
      ))) %>%
      as.numeric() %>%
      replace_na(0)
  ) %>%
    apply(2, round, digits = 4)
  
  return(result)
}

#' Matriz de datos de desigualdad
#' @param data data frame con los datos de ingresos
#' @param suffix es un valor numérico correspondiente al escenario
#'
#' @export
#'
inq_matriz <- function(data, suffix) {
  # Validar que el sufijo comience con "_"
  if (!grepl("^_", suffix)) {
    stop("El sufijo debe comenzar con '_'.")
  }
  
  # Filtrar y transformar los datos
  p1 <- data %>%
    pivot_wider(
      names_from = c("var", "escenario"), names_sep = "_",
      values_from = Value
    ) %>%
    mutate(
      # Crear dinámicamente las diferencias para múltiples variables
      across(matches(paste0("^(yd|yc|yz|yi|ys)", suffix, "$")),
             ~ get(sub(suffix, "_0", cur_column())) - .,
             .names = "d{.col}"
      )
    )
  
  # Crear una matriz con los resultados de las selecciones específicas
  result <- rbind(
    p1 %>%
      filter(parameter == "Gini") %>%
      select(all_of(c(
        paste0("yd_0"), paste0("yc", suffix),
        paste0("yz", suffix), paste0("yi", suffix), paste0("ys", suffix)
      ))) %>%
      as.numeric(),
    p1 %>%
      filter(parameter == "Gini") %>%
      select(matches(paste0("^d(yd|yc|yz|yi|ys)", suffix, "$"))) %>%
      as.numeric(),
    p1 %>%
      filter(parameter == "Palma") %>%
      select(all_of(c(
        paste0("yd_0"), paste0("yc", suffix),
        paste0("yz", suffix), paste0("yi", suffix), paste0("ys", suffix)
      ))) %>%
      as.numeric(),
    p1 %>%
      filter(parameter == "Theil") %>%
      select(all_of(c(
        paste0("yd_0"), paste0("yc", suffix),
        paste0("yz", suffix), paste0("yi", suffix), paste0("ys", suffix)
      ))) %>%
      as.numeric()
  ) %>%
    apply(2, round, digits = 4)
  
  return(result)
}

weighted_sum <- function(x, w, na.rm = TRUE) {
  sum(x * w, na.rm = na.rm)
}


#' Estimar concentración según grupo especificado (% del total que va al grupo)
#' @param current_data data frame con los datos de ingresos
#' @param suffix es un valor numérico correspondiente al escenario
#' @param weight_var es el factor de expansión
#' @param rank es la variable de agrupación (deciles, por ejemplo)
#'
#' @export
#'
decile_con <- function(current_data, suffix, weight_var, rank) {
  # Pre-calcular nombres
  dif1 <- paste0("ditx_itb", suffix, "_pc")
  dif2 <- paste0("dsub_ele", suffix, "_pc")
  dif3 <- paste0("dcomp", suffix, "_pc")
  neto <- paste0("nitx", suffix, "_pc")
  variables_to_sum <- c(
    "itx_itb0_pc", "sub_ele0_pc",
    paste0("itx_itb", suffix, "_pc"),
    paste0("sub_ele", suffix, "_pc"),
    paste0("comp", suffix, "_pc"),
    paste0("ditx_itb", suffix, "_pc"),
    paste0("dsub_ele", suffix, "_pc"),
    paste0("dcomp", suffix, "_pc"), paste0("nitx", suffix, "_pc")
  )
  
  current_data <- current_data %>%
    filter(!is.na({{ rank }})) %>%
    mutate(
      !!sym(dif1) := !!sym(paste0("itx_itb", suffix, "_pc")) - itx_itb0_pc,
      !!sym(dif2) := !!sym(paste0("sub_ele", suffix, "_pc")) - sub_ele0_pc,
      !!sym(dif3) := !!sym(paste0("comp", suffix, "_pc")),
      !!sym(neto) := !!sym(dif1) + !!sym(dif2) - !!sym(dif3)
    ) %>%
    group_by({{ rank }}) %>%
    summarise(across(all_of(variables_to_sum), ~
                       sum(. * .data[[weight_var]], na.rm = TRUE))) %>%
    arrange({{ rank }}) %>%
    filter(!is.na({{ rank }})) %>%
    as_tibble() %>%
    adorn_totals("row")
  
  numeric_cols <- current_data %>%
    select_if(is.numeric) %>%
    names()
  
  # Obtener los valores de la última fila para columnas numéricas
  last_row <- current_data %>%
    slice_tail(n = 1) %>%
    select(all_of(numeric_cols))
  
  # Normalizar todas las columnas numéricas
  current_data <- current_data %>%
    mutate(across(
      all_of(numeric_cols),
      ~ . * 100 / last_row[[cur_column()]]
    )) %>%
    mutate(across(where(is.numeric), ~ if_else(is.na(.), 0, round(., digits = 1))))
  
  current_data
}

#' Estimar incidencia fiscal según grupo especificado (variable / ing disponible)
#' @param current_data data frame con los datos de ingresos
#' @param suffix es un valor numérico correspondiente al escenario
#' @param weight_var es el factor de expansión
#' @param rank es la variable de agrupación (deciles, por ejemplo)
#'
#' @export
#'
decile_inc <- function(current_data, suffix, weight_var, rank) {
  # Pre-calcular nombres
  dif1 <- paste0("ditx_itb", suffix, "_pc")
  dif2 <- paste0("dsub_ele", suffix, "_pc")
  dif3 <- paste0("dcomp", suffix, "_pc")
  neto <- paste0("nitx", suffix, "_pc")
  
  variables_to_sum <- c(
    "itx_itb0_pc", "sub_ele0_pc",
    paste0("itx_itb", suffix, "_pc"),
    paste0("sub_ele", suffix, "_pc"),
    paste0("comp", suffix, "_pc"),
    dif1, dif2, dif3, neto
  )
  
  # Pipeline optimizada con adorn_totals (más confiable)
  result <- current_data %>%
    filter(!is.na({{ rank }})) %>%
    mutate(
      !!sym(dif1) := !!sym(paste0("itx_itb", suffix, "_pc")) - itx_itb0_pc,
      !!sym(dif2) := !!sym(paste0("sub_ele", suffix, "_pc")) - sub_ele0_pc,
      !!sym(dif3) := !!sym(paste0("comp", suffix, "_pc")),
      !!sym(neto) := !!sym(dif1) + !!sym(dif2) - !!sym(dif3)
    ) %>%
    group_by({{ rank }}) %>%
    summarise(
      incpc = sum(yd_pc * !!sym(weight_var), na.rm = TRUE),
      across(
        all_of(variables_to_sum),
        ~ sum(.x * !!sym(weight_var), na.rm = TRUE)
      ),
      .groups = "drop"
    ) %>%
    arrange({{ rank }}) %>%
    janitor::adorn_totals("row") %>%
    mutate(
      across(
        all_of(variables_to_sum),
        ~ round((.x * 100) / incpc, 2)
      )
    ) %>%
    select(-incpc)
  
  return(result)
}

#' Estimar totales según grupo especificado (en millones)
